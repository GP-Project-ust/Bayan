flowchart TD
    A[فتح مركز التقارير /reports] --> B[اختيار معاينة كاملة]
    C[بعد معالج إنشاء التقرير] --> D[رابط معاينة مثال تدريبي مستقل]
    B --> E[فتح /reports/detail?report=ID]
    D --> E
    E --> F{هل يملك صلاحية العرض؟}
    F -- لا --> X[عرض منع الوصول 403 تجريبي]
    F -- نعم --> G{هل التقرير موجود؟}
    G -- لا --> Y[حالة التقرير غير موجود]
    G -- نعم --> H{هل الحالة جاهز؟}
    H -- لا --> Z[عرض الحالة دون أرقام ودون تصدير]
    H -- نعم --> I[معاينة صفحتي A4: ملخص وجدول]
    I --> J[التنقل بين الصفحات والتكبير]
    J --> K{هل يريد التصدير؟}
    K -- لا --> I
    K -- نعم --> L{هل يمتلك reports.export؟}
    L -- لا --> M[تعطيل أدوات التصدير]
    L -- نعم --> N{اختيار التنسيق}
    N -- CSV --> O[إنشاء CSV محلي بتنسيق UTF-8]
    N -- XLSX --> P[إنشاء مصنف Excel OOXML محلي]
    N -- PDF --> Q[فتح طباعة المتصفح / حفظ PDF]
    O --> R[تنزيل ملف تدريبي]
    P --> R
    Q --> S[حفظ ملف PDF من نافذة الطباعة]
