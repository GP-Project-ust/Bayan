flowchart TD
 A[فتح سجل عمليات التهيئة] --> B{دور مسؤول المنصة وصلاحيات التهيئة؟}
 B -->|لا| C[رفض الوصول 403 تجريبي]
 B -->|نعم| D[قراءة الأمثلة الاصطناعية والسجلات المحلية المسموحة]
 D --> E[إحصاءات وتصفية وبحث وتاريخ]
 E --> F{نطاق التواريخ صحيح؟}
 F -->|لا| G[عرض خطأ تاريخ وتوقيف التصدير]
 F -->|نعم| H[جدول عمليات التهيئة]
 H --> I{اختيار عملية}
 I -->|تفاصيل| J[عرض خطوات التنفيذ الست ونتائجها]
 I -->|تصدير| K[CSV وصفي تجريبي فقط]
 J --> L{فشل أو توقف ومؤسسة مؤهلة؟}
 L -->|لا| M[قراءة التفاصيل فقط]
 L -->|نعم| N[تأكيد إنشاء مسودة إعادة المحاولة]
 N --> O{التخزين المحلي متاح؟}
 O -->|لا| P[رسالة خطأ بلا تنفيذ]
 O -->|نعم| Q[إعادة ضبط فحوص المخطط والفهرسة]
 Q --> R[فتح معالج التهيئة من البداية]
 S[اكتمال محاكاة معالج التهيئة] --> T{نجح حفظ ملخص وصفي محلي؟}
 T -->|نعم| D
 T -->|لا| U[إبلاغ المستخدم بعدم حفظ السجل]
 classDef primary fill:#E7F8FA,stroke:#00A6B2,color:#0A2342
 classDef warn fill:#FFF3E3,stroke:#C69247,color:#733C0D
 classDef deny fill:#FFECEC,stroke:#D55B63,color:#7B2027
 class A,D,E,H,J,N,Q,R,S,T primary
 class G,M,P,U warn
 class C deny
