flowchart TD
    A[فتح لوحة التحليلات] --> B[الانتقال إلى اكتشاف القيم الشاذة]
    B --> C{لدى الدور صلاحية التحليلات؟}
    C -->|لا| D[عرض منع الوصول التجريبي]
    C -->|نعم| E[عرض تنبيه البيانات التدريبية]
    E --> F[تحميل الحالات الافتراضية]
    F --> G[اختيار الفترة والكلية والقسم والمؤشر]
    G --> H[تطبيق مرشحات الخطورة والحالة والبحث]
    H --> I{هل توجد حالات؟}
    I -->|لا| J[حالة لا توجد نتائج وإعادة ضبط]
    J --> G
    I -->|نعم| K[مؤشرات وتوزيع الخطورة وجدول الحالات]
    K --> L{الإجراء المختار}
    L -->|تفاصيل| M[مقارنة القيمة بخط أساس توضيحي]
    M --> N[تعديل حالة المراجعة محليا]
    N --> K
    L -->|تصدير| O{هل يملك صلاحية التصدير؟}
    O -->|نعم| P[تنزيل CSV تدريبي بالفلاتر الحالية]
    O -->|لا| Q[إخفاء أو تعطيل التصدير]
    L -->|العودة| R[لوحة التحليلات]
    classDef primary fill:#E7F8FA,stroke:#00A6B2,color:#0A2342;
    classDef decision fill:#FFF3DE,stroke:#C28C29,color:#0A2342;
    classDef blocked fill:#FBE9EC,stroke:#CB5668,color:#0A2342;
    class A,B,E,F,G,H,K,M,N,P,R primary;
    class C,I,L,O decision;
    class D,Q blocked;
