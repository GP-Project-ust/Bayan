flowchart TD
  A([فتح مركز التقارير /reports]) --> B{صلاحية reports.view؟}
  B -- لا --> C[واجهة منع الوصول 403 - محاكاة]
  B -- نعم --> D[جلب قائمة التقارير من بيانات أمثلة محلية]
  D --> E[عرض المؤشرات والجدول]
  E --> F[بحث / تصنيف / حالة / شهر / ترتيب]
  F --> G{هل توجد نتائج؟}
  G -- لا --> H[حالة لا توجد تقارير مطابقة]
  H --> F
  G -- نعم --> I[اختيار تقرير]
  I --> J[فتح درج التفاصيل والمصدر والفترة]
  J --> K{حالة التقرير؟}
  K -- جاهز --> L[عرض المؤشرات والصفوف]
  K -- مسودة أو قيد الإنشاء أو فشل --> M[عرض الحالة وتفسير عدم جاهزية النتائج]
  L --> N{صلاحية reports.export؟}
  N -- نعم --> O[إنشاء ملف CSV من بيانات مثال محلية]
  N -- لا --> P[حجب إجراء التصدير]
  O --> Q[تحميل ملف موصوف بكونه تجريبياً]
  M --> R[منع التصدير]
  E --> S{صلاحية reports.create؟}
  S -- نعم --> T[رابط /reports/new - قالب إنشاء تقرير لاحق]
  S -- لا --> U[إخفاء زر إنشاء التقرير]
  style C fill:#fff0f0,stroke:#b34444
  style Q fill:#e1f7f0,stroke:#168a75
