flowchart TD
 A[الدخول من لوحة الإدارة] --> B{هل الدور مسؤول تقنية المعلومات؟}
 B -->|لا| C[عرض رفض الوصول في النموذج]
 B -->|نعم| D[تحميل الحسابات الوهمية من المتصفح أو بيانات المثال]
 D --> E[إظهار مؤشرات المستخدمين والمرشحات والجدول]
 E --> F{العملية المطلوبة}
 F -->|بحث أو تصفية| G[تطبيق المرشحات والصفحات]
 G --> E
 F -->|تفاصيل| H[فتح درج تفاصيل المستخدم]
 H --> E
 F -->|إضافة| I[إدخال الاسم والبريد والدور والقسم]
 I --> J{الحقول صحيحة والبريد غير مكرر؟}
 J -->|لا| K[عرض رسالة تحقق]
 K --> I
 J -->|نعم| L[إضافة سجل تجريبي محلي]
 L --> E
 F -->|تعديل| M[تحديث البيانات أو الدور]
 M --> N{يحافظ الإجراء على مسؤول الإدارة الحالي وآخر مسؤول نشط؟}
 N -->|لا| O[رفض التعديل وشرح السبب]
 O --> M
 N -->|نعم| P[حفظ التعديل محليًا]
 P --> E
 F -->|تنشيط أو تعطيل| Q[طلب تأكيد]
 Q --> R{الحماية تسمح بالإجراء؟}
 R -->|لا| S[رفض الإجراء]
 R -->|نعم| T[تحديث حالة الحساب في المعاينة]
 T --> E
 S --> E
 F -->|استعادة| U[تأكيد استعادة البيانات الافتراضية]
 U --> E
 classDef primary fill:#E7F8FA,stroke:#00A6B2,color:#0A2342;
 classDef decision fill:#FFF3DE,stroke:#C28C29,color:#0A2342;
 classDef denied fill:#FBE9EC,stroke:#CB5668,color:#0A2342;
 class A,D,E,G,H,I,L,M,P,Q,T,U primary;
 class B,F,J,N,R decision;
 class C,K,O,S denied;
