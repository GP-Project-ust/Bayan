flowchart TD
  A[فتح صفحة إضافة مستخدم] --> B{صلاحية users.manage؟}
  B -- لا --> X[منع الوصول مع رسالة عربية]
  B -- نعم --> C[إدخال الاسم والبريد]
  C --> D{صحة المدخلات وعدم التكرار؟}
  D -- لا --> C
  D -- نعم --> E[اختيار القسم والدور المؤسسي]
  E --> F{هل الدور والقسم معتمدان؟}
  F -- لا --> E
  F -- نعم --> G[مراجعة بيانات المستخدم]
  G --> H{تأكيد الإضافة؟}
  H -- لا --> G
  H -- نعم --> I[قراءة أحدث قائمة محلية وإعادة التحقق]
  I --> J{البيانات صالحة؟}
  J -- لا --> C
  J -- نعم --> K[إنشاء سجل تجريبي وحفظ محلي]
  K --> L{نجح التخزين؟}
  L -- لا --> M[رسالة خطأ وعدم الادعاء بالنجاح]
  L -- نعم --> N[تأكيد محلي وتوجيه إلى قائمة المستخدمين]
