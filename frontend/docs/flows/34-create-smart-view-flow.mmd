flowchart TD
    A([فتح إنشاء عرض ذكي]) --> B{صلاحية إدارة العروض؟}
    B -- لا --> Z[منع الوصول والعودة للإدارة]
    B -- نعم --> C[تحديد الاسم والوصف والمصدر التدريبي]
    C --> D{مصدر مسموح وله مخطط؟}
    D -- لا --> C
    D -- نعم --> E[اختيار جدول وحقول تدريبية]
    E --> F{الحقول آمنة؟}
    F -- لا --> E
    F -- نعم --> G[تصنيف العرض والجمهور وشروط رمزية]
    G --> H{التصنيف يكفي؟}
    H -- لا --> G
    H -- نعم --> I[معاينة JSON وSQL تصوري دون تنفيذ]
    I --> J{إقرار المستخدم؟}
    J -- لا --> I
    J -- نعم --> K[مراجعة الملخص النهائي]
    K --> L{اسم فريد ومساحة حفظ؟}
    L -- لا --> K
    L -- نعم --> M[حفظ مسودة في localStorage فقط]
    M --> N[إظهار المسودة في قائمة العروض]
    N --> O([انتهاء — لم يحدث نشر أو استعلام])
