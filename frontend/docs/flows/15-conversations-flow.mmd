flowchart TD
    A([فتح سجل المحادثات /conversations]) --> B{هل يملك الدور حق عرض المحادثات؟}
    B -->|لا| U[رسالة منع الوصول التجريبية]
    B -->|نعم| C[تحميل عينات السجل وتعديلات localStorage]
    C --> D[عرض الإحصاءات والقائمة]
    D --> E{اختيار العملية}
    E -->|بحث وتصفية وترتيب| F[تطبيق المرشحات محليا]
    F --> G{هل توجد نتائج؟}
    G -->|نعم| D
    G -->|لا| H[حالة لا توجد محادثات]
    H --> E
    E -->|عرض المحادثة| I[فتح درج الرسائل]
    I --> J{صالح لعرض المصادر أو SQL؟}
    J -->|نعم| K[عرض التفاصيل المسموحة في التجربة]
    J -->|لا| L[إخفاء التفاصيل المقيدة]
    K --> M[سؤال متابعة تجريبي محلي]
    L --> M
    M --> E
    E -->|إعادة التسمية| N[التحقق من العنوان ثم الحفظ المحلي]
    N --> D
    E -->|إضافة أو إزالة المفضلة| O[تحديث المفضلة محليا]
    O --> D
    E -->|حذف| P{تأكيد حذف المحادثة؟}
    P -->|لا| D
    P -->|نعم| Q[إخفاء المحادثة من المعاينة وحفظ التغيير]
    Q --> D
    E -->|استعادة| R{تأكيد إعادة البيانات؟}
    R -->|نعم| S[مسح تعديلات التجربة وإعادة العينات]
    R -->|لا| D
    S --> D
    E -->|محادثة جديدة| T([فتح واجهة المحادثة الرئيسية])
