flowchart TD
  A[فتح إدارة العروض الذكية /admin/smart-views] --> B{صلاحية smartviews.manage؟}
  B -- لا --> C[إظهار منع الوصول التجريبي]
  B -- نعم --> D[تحميل العروض التوضيحية وحالات localStorage]
  D --> E[مطابقة المصادر واستبعاد المحظور]
  E --> F[عرض البطاقات والجدول]
  F --> G{اختيار إجراء}
  G -- بحث / تصفية --> H[تطبيق مرشحات الاسم والمصدر والحالة والتصنيف]
  H --> F
  G -- تفاصيل --> I[فتح درج التفاصيل والحقول المسموحة]
  I --> J[عرض مصدر البيانات ونسخ الوصف]
  J --> F
  G -- تغيير حالة --> K{عرض تجريبي قابل للإيقاف؟}
  K -- لا --> F
  K -- نعم --> L[تأكيد إيقاف أو تنشيط محلي]
  L --> M{نجاح localStorage؟}
  M -- لا --> N[إظهار خطأ وعدم ادعاء الحفظ]
  M -- نعم --> O[تحديث الحالة محليا]
  N --> F
  O --> F
  G -- إنشاء عرض جديد --> P[الانتقال إلى واجهة الإنشاء التالية]
  subgraph Backend_لاحقا[التكامل الحقيقي لاحقا - غير منفذ]
    Q[مصادقة وعزل المؤسسة]
    R[التحقق من الحقول والتصنيف وقراءة فقط]
    S[التدقيق والاعتماد على FastAPI]
    Q --> R --> S
