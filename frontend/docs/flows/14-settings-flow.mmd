flowchart TB
  A[فتح صفحة الإعدادات /settings] --> B[قراءة التفضيلات من المتصفح]
  B --> C{هل البيانات صالحة؟}
  C -- نعم --> D[تهيئة الحقول من التفضيلات]
  C -- لا --> E[استخدام القيم الافتراضية]
  D --> F[اختيار القسم]
  E --> F
  F --> G[تعديل تفضيل وإظهار المعاينة]
  G --> H{هل يؤثر التفضيل في صلاحية؟}
  H -- نعم --> I[تطبيق فلترة عرض حسب الدور التجريبي]
  H -- لا --> J[تحديث المعاينة]
  I --> J
  J --> K{المستخدم يريد الحفظ؟}
  K -- إلغاء --> L[العودة لآخر قيم محفوظة]
  K -- نعم --> M[التحقق من القيم وحفظها محليًا]
  M --> N{هل نجح التخزين؟}
  N -- نعم --> O[إشعار نجاح محلي]
  N -- لا --> P[إشعار تعذر التخزين]
  O --> Q{استعادة الافتراضيات؟}
  P --> Q
  Q -- نعم --> R[تأكيد مسح بيانات المعاينة]
  R --> E
  Q -- لا --> F
  Z[[مهم: حماية SQL وبيانات المؤسسة على الخادم فقط]]
  I -.-> Z
