flowchart TD
    A[مسؤول المنصة] --> B[فتح شاشة مراقبة الوكلاء]
    B --> C{التحقق من صلاحية platform.manage}
    C -->|غير مخوّل| D[عرض حالة منع الوصول]
    C -->|مخوّل في المعاينة| E[تحميل تعريفات الوكلاء ومقاييس العينة]
    E --> F[تجميع خطوات التتبعات الاصطناعية]
    F --> G[حساب النجاح والفشل والرفض والمدة]
    G --> H[عرض البطاقات والمؤشرات]
    H --> I[البحث والتصفية]
    H --> J[فتح تفاصيل وكيل]
    J --> K[عرض المسؤولية والمدخلات والمخرجات]
    J --> L{هل تتوفر traces.view؟}
    L -->|نعم| M[إتاحة رابط تفاصيل التتبع المصرح]
    L -->|لا| N[إخفاء تفاصيل تتبع المؤسسة]
    H --> O[تصدير CSV للملخصات فقط]
    H --> P[الانتقال لصحة الخدمات أو مزودي النماذج]
    style D fill:#fff0f0,stroke:#c65b60,color:#7d2932
    style E fill:#eaf8fa,stroke:#00a6b2,color:#0a2342
    style H fill:#eaf8fa,stroke:#00a6b2,color:#0a2342
    style N fill:#fff5e8,stroke:#d7a24b,color:#6b4c16

subgraph ARCH[المسار المعماري التوضيحي]
  S[Supervisor] -->|توجيه| Q{نوع الطلب}
  Q -->|بيانات| SQL[SQL Agent]
  Q -->|مستندات| RAG[RAG Agent]
  SQL -->|تحليل عند الحاجة| AN[Analyst Agent]
  SQL --> REP[Reporter Agent]
  AN --> REP
  RAG -->|مراجع واستشهادات| REP
end
