digraph G {
 graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", pad=0.35, nodesep=0.38, ranksep=0.55, label="بيان — تدفق شاشة تفاصيل العرض الذكي (تجريبي)", labelloc="t", fontsize=22, fontcolor="#0A2342"];
 node [shape=box, style="rounded,filled", fillcolor="#F3FAFD", color="#CCDFEB", fontname="DejaVu Sans", fontsize=13, penwidth=1.3, margin="0.22,0.16"];
 edge [fontname="DejaVu Sans", color="#327E94", fontsize=11, arrowsize=0.75];
 A [label="فتح عرض ذكي\nمن القائمة أو مسودة", fillcolor="#E2F7F8"];
 B [label="فحص صلاحية الدور", shape=diamond, fillcolor="#EAF2FA"];
 C [label="منع الوصول 403\nداخل الواجهة", fillcolor="#FFF1EC", color="#E9B3A7"];
 D [label="التحقق من معرّف العرض\nواستعادة البيانات المحلية"];
 E [label="عرض صالح وموجود؟", shape=diamond, fillcolor="#EAF2FA"];
 F [label="رابط غير صالح / مسودة محذوفة", fillcolor="#FFF3E8", color="#E8CAB5"];
 G [label="صفحة التفاصيل\nبيانات · حقول · تصنيف", fillcolor="#E6F8F8"];
 H [label="اختيار فحص محلي", shape=diamond, fillcolor="#EAF2FA"];
 I [label="فحص المصدر وبنية الحقول والتصنيف"];
 J [label="اجتياز قواعد المعاينة؟", shape=diamond, fillcolor="#EAF2FA"];
 K [label="نتيجة وصفية + صفوف اصطناعية\nعند السماح فقط", fillcolor="#E6FAF0", color="#9FD1BD"];
 L [label="تنبيه مراجعة / منع صفوف", fillcolor="#FFF3E8", color="#E8CAB5"];
 M [label="لا اتصال أو SQL منفّذ أو نشر", fillcolor="#E7F1FA", color="#B8D5E5"];
 A -> B; B -> C [label="غير مصرح"]; B -> D [label="مصرح"]; D -> E;
 E -> F [label="لا"]; E -> G [label="نعم"]; G -> H;
 H -> I [label="فحص"]; H -> M [label="عرض فقط"];
 I -> J; J -> K [label="نعم"]; J -> L [label="لا"]; K -> M; L -> M;
}
