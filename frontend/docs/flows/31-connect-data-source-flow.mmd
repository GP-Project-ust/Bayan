flowchart TD
    A[فتح إدارة مصادر البيانات] --> B[اختيار ربط مصدر جديد]
    B --> C{صلاحية sources.manage؟}
    C -- لا --> D[رسالة رفض الوصول]
    C -- نعم --> E[1. بيانات ونوع المصدر]
    E --> F{البيانات صحيحة وغير مكررة؟}
    F -- لا --> E
    F -- نعم --> G[2. عنوان example.invalid ومنفذ تدريبي]
    G --> H{صيغة عنوان ومنفذ صحيحة؟}
    H -- لا --> G
    H -- نعم --> I[3. النطاق والتصنيف والإقرار]
    I --> J{التصنيف والإقرار صالحان؟}
    J -- لا --> I
    J -- نعم --> K[4. محاكاة تحقق محلية بلا شبكة]
    K --> L{المحاكاة اجتازت فحص الحقول؟}
    L -- لا --> E
    L -- نعم --> M[5. مراجعة بيانات المصدر]
    M --> N{تأكيد الحفظ؟}
    N -- لا --> M
    N -- نعم --> O{نجح حفظ البيانات الوصفية محلياً؟}
    O -- لا --> P[رسالة خطأ والحفاظ على النموذج]
    P --> M
    O -- نعم --> Q[نجاح تجريبي: pending أو disabled]
    Q --> R[العودة إلى قائمة مصادر البيانات]
    R --> S[عرض المصدر التدريبي الجديد]
