# =============================================================================
# بيان — قالب متغيرات البيئة
# =============================================================================
# انسخه إلى ‎.env وعدّل القيم حسب بيئتك:   cp .env.example .env
# تنبيه: ملف ‎.env لا يُرفع إلى Git أبداً (موجود في .gitignore)

# ---------- قاعدة بيانات المنصة (محادثات + ذاكرة + تدقيق) ----------
# الوضع الافتراضي يوافق docker compose (خدمة db)
DATABASE_URL=postgresql://bayan:bayan@localhost:5432/bayan

# ---------- بنية تحتية مساندة ----------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ---------- النموذج اللغوي ----------
# المزوّد الافتراضي mock: ردود حتمية بلا أي اتصال — مثالي لأول تشغيل واختبارات
# البدل المتاح فوراً: ollama (محلي، بلا مفاتيح) — ثم السحابي عند الحاجة
# LLM_PROVIDER=mock | ollama | openai | anthropic | gemini
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# ---------- التضمين (ADR-005: bge-m3 عبر Ollama — 1024 بعداً) ----------
# مزوّد مستقل عن مزوّد النموذج اللغوي — راجع app/core/qdrant.py
# mock = متجهات حتمية بلا أي اتصال (افتراضي التطوير وCI)
# EMBEDDING_PROVIDER=mock | ollama
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# فارغ = يفرَّغ تلقائياً إلى OLLAMA_BASE_URL (يضبط فقط لخادم تضمين مستقل)
EMBEDDING_BASE_URL=

# ---------- بيئة الاختبار: قاعدة بيانات الجامعة (قراءة فقط) ----------
# بيان لا يكتب في قاعدة الجامعة إطلاقاً — اتصال عبر دور القراءة فقط
# القاعدة التجريبية الموحدة تُجهَّز بأمر واحد: make dev-db
# (راجع database/university_demo/README.md — بديل خفيف عن رفع Odoo كاملاً)
ODOO_DB_HOST=localhost
ODOO_DB_PORT=5433
ODOO_DB_NAME=university
ODOO_DB_USER=bayan_reader
ODOO_DB_PASSWORD=bayan_dev_reader
# تجاوز كامل للرابط أعلاه إن ضُبط (يستخدم أحياناً في الاختبارات المحلية):
# ODOO_DB_DSN=postgresql://bayan_reader:bayan_dev_reader@localhost:5433/university

# ---------- الواجهة الأمامية ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- إعدادات عامة ----------
# واجهة الاختبار الموحدة — عطّلها في الإنتاج: ENABLE_PLAYGROUND=false
ENABLE_PLAYGROUND=true
# النطاقات المسموح لها بندبات CORS (افصل بفواصل)
CORS_ORIGINS=http://localhost:3000
