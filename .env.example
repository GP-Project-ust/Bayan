# =============================================================================
# بيان — قالب متغيرات البيئة
# =============================================================================
# انسخه إلى ‎.env وعدّل القيم حسب بيئتك:   cp .env.example .env
# تنبيه: ملف ‎.env لا يُرفع إلى Git أبداً (موجود في .gitignore)

# ---------- قاعدة بيانات المنصة (محادثات + ذاكرة + تدقيق) ----------
# الوضع الافتراضي يوافق docker compose (خدمة db)
DATABASE_URL=postgresql://bayan:bayan@localhost:5432/bayan

# ---------- بنية تحتية مساندة ----------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ---------- النموذج اللغوي ----------
# المزوّد الافتراضي محلي (Ollama). لاحقاً: يمكن التبديل لمزوّد سحابي من الإعدادات
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# ---------- بيئة الاختبار: قاعدة بيانات الجامعة (Odoo/OpenEduCat) ----------
# اتصال "قراءة فقط" — بيان لا يكتب في قاعدة الجامعة إطلاقاً
# جهّزها من مستودع openeducat-yemen-university (راجع database/README.md)
ODOO_DB_HOST=localhost
ODOO_DB_PORT=5433
ODOO_DB_NAME=university
ODOO_DB_USER=bayan_reader
ODOO_DB_PASSWORD=change-me

# ---------- الواجهة الأمامية ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- إعدادات عامة ----------
# النطاقات المسموح لها بندبات CORS (افصل بفواصل)
CORS_ORIGINS=http://localhost:3000
